{
  "name": "@connectaryal/google-analytics",
  "version": "1.2.0",
  "description": "A modern, type-safe, and performance-optimized Google Analytics 4 (GA4) tracking library for React and Next.js applications. Features comprehensive ecommerce tracking, automatic event batching, SSR support, and production-ready error handling. Built with TypeScript for enterprise-grade reliability.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --emitDeclarationOnly && tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "jsdom": "^26.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "keywords": [
    "react",
    "next.js",
    "nextjs",
    "google-analytics",
    "google-analytics-4",
    "ga4",
    "gtag",
    "analytics",
    "tracking",
    "ecommerce",
    "ecommerce-tracking",
    "enhanced-ecommerce",
    "typescript",
    "type-safe",
    "web-vitals",
    "conversion-tracking",
    "event-tracking",
    "page-tracking",
    "measurement-protocol"
  ],
  "author": {
    "name": "Shiva Aryal",
    "email": "aryalshiva005@gmail.com",
    "url": "https://github.com/connectaryal"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/connectaryal/google-analytics.git"
  },
  "bugs": {
    "url": "https://github.com/connectaryal/google-analytics/issues"
  },
  "homepage": "https://github.com/connectaryal/google-analytics#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
